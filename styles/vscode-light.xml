<?xml version="1.0" encoding="UTF-8"?>
<!-- Editor colours of VS Code's Light+ / Light Modern theme, matching the read-only Source view (SOURCE_CSS). -->
<style-scheme id="vscode-light" name="VS Code Light+" version="1.0">
  <description>VS Code Light+ colours for the Markdown Viewer editor</description>

  <!-- Editor -->
  <style name="text"                    foreground="#3b3b3b" background="#ffffff"/>
  <style name="selection"               background="#add6ff"/>
  <style name="selection-unfocused"     background="#e5ebf1"/>
  <style name="cursor"                  foreground="#000000"/>
  <style name="current-line"            background="#f3f3f3"/>
  <style name="line-numbers"            foreground="#6e7681" background="#ffffff"/>
  <style name="current-line-number"     foreground="#171184" background="#f3f3f3"/>
  <style name="bracket-match"           background="#e5e5e5"/>
  <style name="search-match"            background="#a8ac94"/>

  <!-- Markdown -->
  <style name="markdown:header"            foreground="#800000" bold="true"/>
  <style name="markdown:list-marker"       foreground="#0451a5"/>
  <style name="markdown:blockquote-marker" foreground="#0451a5"/>
  <style name="markdown:code-span"         foreground="#800000"/>
  <style name="markdown:code-block"        foreground="#800000"/>
  <style name="markdown:link-text"         foreground="#a31515"/>
  <style name="markdown:label"             foreground="#a31515"/>
  <style name="markdown:image-marker"      foreground="#a31515"/>
  <style name="markdown:url"               foreground="#0070c1"/>
  <style name="markdown:attribute-value"   foreground="#a31515"/>
  <style name="markdown:emphasis"          italic="true"/>
  <style name="markdown:strong-emphasis"   bold="true"/>
  <style name="markdown:backslash-escape"  foreground="#ee0000"/>
  <style name="markdown:horizontal-rule"   foreground="#3b3b3b"/>
  <style name="markdown:line-break"        foreground="#3b3b3b"/>
  <style name="mdviewer-markdown:quote"    foreground="#0451a5" italic="true"/>
  <style name="mdviewer-markdown:code-fence" foreground="#800000"/>

  <!-- Code in fenced blocks (same colours as HIGHLIGHT_CSS) -->
  <style name="def:keyword"          foreground="#0000ff"/>
  <style name="def:special-constant" foreground="#0000ff"/>
  <style name="def:boolean"          foreground="#0000ff"/>
  <style name="def:statement"        foreground="#af00db"/>
  <style name="def:preprocessor"     foreground="#af00db"/>
  <style name="def:function"         foreground="#795e26"/>
  <style name="def:builtin"          foreground="#795e26"/>
  <style name="def:type"             foreground="#267f99"/>
  <style name="def:identifier"       foreground="#001080"/>
  <style name="def:string"           foreground="#a31515"/>
  <style name="def:character"        foreground="#a31515"/>
  <style name="def:special-char"     foreground="#ee0000"/>
  <style name="def:number"           foreground="#098658"/>
  <style name="def:comment"          foreground="#008000" italic="true"/>
  <style name="def:net-address"      foreground="#0070c1"/>
  <style name="def:error"            underline="error" underline-color="#e51400"/>
  <style name="xml:element-name"     foreground="#800000"/>
  <style name="xml:attribute-name"   foreground="#e50000"/>
  <style name="xml:attribute-value"  foreground="#0000ff"/>
  <style name="diff:added-line"      foreground="#098658"/>
  <style name="diff:removed-line"    foreground="#a31515"/>
</style-scheme>
