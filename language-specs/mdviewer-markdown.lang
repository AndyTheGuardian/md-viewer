<?xml version="1.0" encoding="UTF-8"?>
<!--
  Markdown for the Markdown Viewer editor: GtkSourceView's own markdown.lang, plus
  - fenced code blocks highlighted in their language (```python, ```js, ...), and
  - block quotes whose text is coloured, not only the ">" marker,
  so the editor looks like the read-only Source view.
  Code inside a fence is highlighted line by line: a construct the embedded language leaves
  open at the end of a line (a JS template string, a Python docstring) can then never
  swallow the closing ```. The price: multi-line strings and comments are only coloured
  on their first line.
  Fence tags not listed here fall back to markdown.lang's one-colour code block.
-->
<language id="mdviewer-markdown" name="Markdown (Markdown Viewer)" version="2.0" _section="Markup" hidden="true">
  <metadata>
    <property name="globs">*.md;*.markdown;*.mdown;*.mkd</property>
    <property name="block-comment-start">&lt;!--</property>
    <property name="block-comment-end">--&gt;</property>
  </metadata>

  <styles>
    <style id="code-fence" name="Code Fence" map-to="markdown:code-block"/>
    <style id="quote" name="Quote Text" map-to="markdown:emphasis"/>
  </styles>

  <definitions>
    <context id="fence-python3">
      <start>^[ ]{0,3}```[ \t]*(?i:python|py|python3)([ \t{].*)?$</start>
      <end>^[ ]{0,3}```[ \t]*$</end>
      <include>
        <context sub-pattern="0" where="start" style-ref="code-fence"/>
        <context sub-pattern="0" where="end" style-ref="code-fence"/>
        <context end-at-line-end="true">
          <start>^(?![ ]{0,3}```[ \t]*$)(?=.)</start>
          <include>
            <context ref="python3:python3"/>
          </include>
        </context>
      </include>
    </context>
